# ContrataFlow — ambiente local (US-078). Copie e use sem editar:  cp .env.example .env
#
# Valores de DESENVOLVIMENTO, públicos e óbvios (RN-FND-19 · DEC-137): nenhum é segredo real e
# nenhum vale fora da sua estação. O `.env` é ignorado pelo Git; produção usa Secrets Manager.
# Porta ocupada? Mude só a porta publicada (*_PORT) — e, se for o caso, a URL correspondente na
# seção "Aplicações" (FA-03). Detalhes e tabela de portas: CONTRIBUTING.md → Ambiente local.

# --- Docker Compose (permite `docker compose ps|logs|stop` direto na raiz) -------------------
COMPOSE_PROJECT_NAME=contrataflow
COMPOSE_FILE=infra/docker-compose.yml:infra/compose/observability.yml:infra/compose/full.yml
COMPOSE_PATH_SEPARATOR=:
# Perfis opcionais (subconjunto de observability,full); vazio = só a infraestrutura padrão.
COMPOSE_PROFILES=

# --- PostgreSQL 17 + pgvector (bancos contrataflow e authentik) -------------------------------
POSTGRES_PASSWORD=devpassword
POSTGRES_PORT=5432

# --- Redis (dois serviços: sessões e cache/filas — DEC-131) -----------------------------------
REDIS_SESSION_PORT=6379
REDIS_CACHE_PORT=6380

# --- MinIO (API S3) ----------------------------------------------------------------------------
MINIO_ROOT_USER=contrataflow
MINIO_ROOT_PASSWORD=devpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Usuário da aplicação com política restrita aos três buckets (storage.md §11), nunca o root.
S3_ACCESS_KEY_ID=contrataflow-app
S3_SECRET_ACCESS_KEY=devpassword
S3_BUCKET_QUARANTINE=contrataflow-dev-quarantine
S3_BUCKET_DOCUMENTS=contrataflow-dev-documents
S3_BUCKET_RENDITIONS=contrataflow-dev-renditions

# --- Authentik (IdP OIDC — DEC-130) ------------------------------------------------------------
# Chave fixa e pública, só para dev (≥ 32 caracteres); nunca usada em produção.
AUTHENTIK_SECRET_KEY=dev-only-insecure-authentik-secret-key-0000
AUTHENTIK_PORT=9080
AUTHENTIK_HTTPS_PORT=9443
# Administrador de bootstrap (akadmin) e token da API: só para os scripts env:* (RN-FND-19).
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@contrataflow.test
AUTHENTIK_BOOTSTRAP_PASSWORD=devpassword
AUTHENTIK_BOOTSTRAP_TOKEN=dev-only-authentik-bootstrap-token
# Cliente confidencial do BFF (provider do blueprint infra/authentik/blueprints).
OIDC_CLIENT_ID=contrataflow-web
OIDC_CLIENT_SECRET=dev-only-oidc-client-secret
# Senha de todos os usuários semeados (<perfil>.<a|b>, ex.: requisitante.a).
CF_DEV_USER_PASSWORD=devpassword

# --- Mailpit, Gotenberg e ClamAV ---------------------------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
GOTENBERG_PORT=3030
CLAMAV_PORT=3310

# --- Observabilidade (perfil observability — FA-02) -------------------------------------------
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# --- Aplicações (pnpm dev, fora do Compose) ----------------------------------------------------
# Consumidas pelas apps a partir da US-080; nomes de architecture.md §10.2. A API usa o papel
# cf_app (sem BYPASSRLS, sem DDL); as migrações usam DATABASE_MIGRATION_URL. Os papéis nascem da
# migração inicial e `pnpm db:migrate` define a senha local deles como POSTGRES_PASSWORD (US-081).
APP_ENV=local
APP_BASE_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
DATABASE_URL=postgresql://cf_app:devpassword@localhost:5432/contrataflow
DATABASE_MIGRATION_URL=postgresql://postgres:devpassword@localhost:5432/contrataflow
# Worker (US-082): relay do outbox com o papel cf_relay (BYPASSRLS só em outbox_events). A purga
# (papel cf_maintenance, DATABASE_URL_MAINTENANCE) chega agendada com a US-083.
DATABASE_URL_RELAY=postgresql://cf_relay:devpassword@localhost:5432/contrataflow
REDIS_SESSION_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6380
REDIS_CACHE_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
OIDC_ISSUER_URL=http://localhost:9080/application/o/contrataflow/
# API (US-080): o `aud` do access token do Authentik local é o client_id do BFF.
OIDC_AUDIENCE=contrataflow-web
# Login real (US-087): BFF com OIDC + PKCE no Authentik do Compose, sessões no Redis de sessões e
# API validando o JWT pelo JWKS. Entre em http://localhost:3000 com <perfil>.<a|b> (ex.:
# requisitante.a) e a senha CF_DEV_USER_PASSWORD; antes, `pnpm db:migrate && pnpm env:seed`.
# SESSION_ENCRYPTION_KEY (32 bytes em base64; cifra os tokens na sessão e o cookie do login) é
# obrigatória fora de local/dev/test. Ausente aqui: chave aleatória por processo — reiniciar o web
# encerra as sessões abertas.
# Credencial de serviço do BFF nas rotas /internal/* da API (a mesma nos dois apps).
INTERNAL_SERVICE_TOKEN=dev-only-internal-service-token-0000000
# API (US-087): confirma no Authentik o usuário do `sub` no primeiro login de um convidado.
AUTHENTIK_API_TOKEN=dev-only-authentik-bootstrap-token
# Identidade fake (FA-06 · testes/E2E do shell): descomente para rodar sem Authentik — BFF e API
# passam a usar pessoas fixas (entre por /api/auth/login?as=ana; pessoas: ana, bruno, davi, eva, gil).
# OIDC_FAKE_SIGNING_KEY=dev-only-fake-jwt-signing-key-000000000000
# Origem confiável de X-Forwarded-For (o ALB em produção; aqui, a própria estação). A API usa a
# mesma variável para aceitar do BFF o IP do cliente e X-CF-Session-Id-Hash (auditoria — US-073);
# o BFF só aceita IPv4 nela.
TRUSTED_PROXY_CIDRS=127.0.0.1/32
# Auditoria (US-073 · parâmetros de plataforma, padrões abaixo; nenhum desliga a gravação):
# AUDIT_COALESCE_WINDOW_MINUTES=10
# AUDIT_COALESCE_MAX_REVISION_GAP=20
# AUDIT_COALESCE_MAX_SIZE_VARIATION_PCT=30
# AUDIT_ACCESS_DENIED_SAMPLING_WINDOW_SECONDS=60
# AUDIT_ACCESS_DENIED_SAMPLING_MAX_PER_WINDOW=20
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/entrar?motivo=saiu
AUTHENTIK_API_URL=http://localhost:9080/api/v3/
GOTENBERG_URL=http://localhost:3030
CLAMAV_HOST=localhost
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="ContrataFlow (dev) <nao-responda@contrataflow.test>"
# Observabilidade (US-084): sem o perfil `observability` o Collector fica fora do ar e
# a falha de exportação vira no máximo um `warn tracing.export_failed` por minuto (a API segue
# respondendo normalmente). Apague a linha para desligar o tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
