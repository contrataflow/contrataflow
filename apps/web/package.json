{
  "name": "@contrataflow/web",
  "version": "0.0.0",
  "private": true,
  "description": "Interface web e BFF (Next.js App Router — DEC-053).",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "node --env-file-if-exists=../../.env node_modules/next/dist/bin/next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@contrataflow/editor": "workspace:*",
    "@contrataflow/types": "workspace:*",
    "@contrataflow/ui": "workspace:*",
    "@contrataflow/validation": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "@tanstack/react-query": "catalog:",
    "next": "catalog:",
    "next-intl": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "react-hook-form": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contrataflow/eslint-config": "workspace:*",
    "@contrataflow/tsconfig": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
