/// entities.md §5 `Risk` (US-033 · DEC-021): risco do processo, com código sequencial `R01`… (único
/// por processo, nunca reaproveitado — RN-RISK-02), `score`/`level` calculados e a escala usada
/// (`scaleSnapshot` — RN-RISK-04). FKs compostas, checks (`score = probability * impact`), gatilho
/// de colunas imutáveis e RLS ficam em SQL bruto na migração. Exclusão só lógica.
model Risk {
  id                  String      @id @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  processId           String      @map("process_id") @db.Uuid
  code                String      @db.VarChar(10)
  title               String      @db.VarChar(200)
  description         String?
  categoryId          String      @map("category_id") @db.Uuid
  phase               RiskPhase
  cause               String
  consequence         String
  probability         Int         @db.SmallInt
  impact              Int         @db.SmallInt
  score               Int         @db.SmallInt
  level               RiskLevel
  scaleSnapshot       Json        @map("scale_snapshot")
  ownerId             String?     @map("owner_id") @db.Uuid
  ownerDepartmentId   String?     @map("owner_department_id") @db.Uuid
  status              RiskStatus  @default(OPEN)
  residualProbability Int?        @map("residual_probability") @db.SmallInt
  residualImpact      Int?        @map("residual_impact") @db.SmallInt
  residualScore       Int?        @map("residual_score") @db.SmallInt
  residualLevel       RiskLevel?  @map("residual_level")
  sortOrder           Int         @default(0) @map("sort_order")
  aiGenerationId      String?     @map("ai_generation_id") @db.Uuid
  aiReviewedAt        DateTime?   @map("ai_reviewed_at") @db.Timestamptz(6)
  aiReviewedById      String?     @map("ai_reviewed_by_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById         String?     @map("created_by_id") @db.Uuid
  updatedById         String?     @map("updated_by_id") @db.Uuid
  deletedAt           DateTime?   @map("deleted_at") @db.Timestamptz(6)
  deletedById         String?     @map("deleted_by_id") @db.Uuid
  version             Int         @default(1)

  @@unique([tenantId, id], map: "risks_tenant_id_id_key")
  @@unique([tenantId, processId, code], map: "risks_code_key")
  @@index([tenantId, processId, level], map: "risks_process_level_idx")
  // Parcial na migração (US-119): só riscos gerados por IA não excluídos.
  @@index([tenantId, processId], map: "risks_ai_generation_idx")
  @@map("risks")
}

/// entities.md §5 `RiskTreatment` (US-034): ação de tratamento do risco. Criada nesta migração para
/// a exclusão em cascata lógica do risco (RN-RISK-10 · US-033); o CRUD é da US-034.
model RiskTreatment {
  id                      String          @id @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  riskId                  String          @map("risk_id") @db.Uuid
  processId               String          @map("process_id") @db.Uuid
  type                    TreatmentType
  description             String
