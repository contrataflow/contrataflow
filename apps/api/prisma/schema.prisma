  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, id], map: "notification_preferences_tenant_id_id_key")
  @@unique([tenantId, userId, notificationType, channel], map: "notification_preferences_key")
  @@map("notification_preferences")
}

