  @@map("price_default_method")
}

/// entities.md §2 — `PriceCalculationMethod`.
enum PriceCalculationMethod {
  MEAN
  MEDIAN
  LOWEST
  MANUAL

  @@map("price_calculation_method")
}

/// entities.md §4.8 `PriceResearch` (módulo price-research · US-024): cabeçalho tipado 1:1 do
/// `Document` do tipo PRICE_RESEARCH com o snapshot de `priceResearch.*` (DEC-020). `id = documentId`
/// (CHECK `price_research_id_is_document`). Checks, FKs compostas e gatilho de colunas imutáveis na
/// migração. Sem status próprio: usa o do documento e `completedAt` (DEC-018).
model PriceResearch {
  id                        String             @id @db.Uuid
  tenantId                  String             @map("tenant_id") @db.Uuid
  processId                 String             @map("process_id") @db.Uuid
  documentId                String             @map("document_id") @db.Uuid
  referenceDate             DateTime           @map("reference_date") @db.Date
  defaultMethod             PriceDefaultMethod @map("default_method")
  cvThresholdPercent        Decimal            @map("cv_threshold_percent") @db.Decimal(9, 4)
  minQuotations             Int                @map("min_quotations")
  directQuoteMaxAgeDays     Int                @map("direct_quote_max_age_days")
  similarContractMaxAgeDays Int                @map("similar_contract_max_age_days")
  outlierLowerPercent       Decimal            @map("outlier_lower_percent") @db.Decimal(9, 4)
  outlierUpperPercent       Decimal            @map("outlier_upper_percent") @db.Decimal(9, 4)
  unitPriceDecimals         Int                @map("unit_price_decimals") @db.SmallInt
  roundingMode              String             @map("rounding_mode") @db.VarChar(10)
  totalEstimatedValue       Decimal?           @map("total_estimated_value") @db.Decimal(18, 2)
  itemsCount                Int                @default(0) @map("items_count")
  itemsWithAlertsCount      Int                @default(0) @map("items_with_alerts_count")
  lastCalculatedAt          DateTime?          @map("last_calculated_at") @db.Timestamptz(6)
  completedAt               DateTime?          @map("completed_at") @db.Timestamptz(6)
  completedById             String?            @map("completed_by_id") @db.Uuid
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById               String?            @map("created_by_id") @db.Uuid
  updatedById               String?            @map("updated_by_id") @db.Uuid
  version                   Int                @default(1)

  @@unique([tenantId, id], map: "price_research_tenant_id_id_key")
  @@unique([tenantId, documentId], map: "price_research_tenant_id_document_id_key")
  @@index([tenantId, processId], map: "price_research_process_idx")
  @@map("price_research")
}

/// entities.md §4.8 `PriceItem` (módulo price-research · US-024): a linha do item canônico
/// (`ProcessItem` — DEC-019) na pesquisa. `ON DELETE CASCADE` a partir de `price_research`; FKs
/// compostas, checks e gatilho de colunas imutáveis na migração.
model PriceItem {
  id                        String                  @id @db.Uuid
  tenantId                  String                  @map("tenant_id") @db.Uuid
  priceResearchId           String                  @map("price_research_id") @db.Uuid
  processItemId             String                  @map("process_item_id") @db.Uuid
  quantity                  Decimal                 @db.Decimal(18, 4)
  methodOverride            PriceCalculationMethod? @map("method_override")
  effectiveMethod           PriceCalculationMethod? @map("effective_method")
  validQuotationsCount      Int                     @default(0) @map("valid_quotations_count")
  meanPrice                 Decimal?                @map("mean_price") @db.Decimal(18, 4)
  medianPrice               Decimal?                @map("median_price") @db.Decimal(18, 4)
  lowestPrice               Decimal?                @map("lowest_price") @db.Decimal(18, 4)
  highestPrice              Decimal?                @map("highest_price") @db.Decimal(18, 4)
  stdDeviation              Decimal?                @map("std_deviation") @db.Decimal(18, 4)
  coefficientOfVariation    Decimal?                @map("coefficient_of_variation") @db.Decimal(9, 4)
  recommendedUnitPrice      Decimal?                @map("recommended_unit_price") @db.Decimal(18, 4)
  manualUnitPrice           Decimal?                @map("manual_unit_price") @db.Decimal(18, 4)
  manualJustification       String?                 @map("manual_justification")
  totalPrice                Decimal?                @map("total_price") @db.Decimal(18, 2)
  belowMinimumJustification String?                 @map("below_minimum_justification")
  alerts                    Json                    @default("[]") @db.JsonB
  notes                     String?
  sortOrder                 Int                     @default(0) @map("sort_order")
  calculatedAt              DateTime?               @map("calculated_at") @db.Timestamptz(6)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById               String?                 @map("created_by_id") @db.Uuid
  updatedById               String?                 @map("updated_by_id") @db.Uuid
  version                   Int                     @default(1)

  @@unique([tenantId, id], map: "price_items_tenant_id_id_key")
  @@unique([tenantId, priceResearchId, processItemId], map: "price_items_research_process_item_key")
  @@index([tenantId, processItemId], map: "price_items_process_item_idx")
  @@map("price_items")
}

enum QuotationStatus {
  VALID
  EXCLUDED

  @@map("quotation_status")
}

enum ExclusionReason {
  UNFEASIBLE
  EXCESSIVE
  INCONSISTENT
  EXPIRED
  NON_COMPLIANT
  OTHER

  @@map("exclusion_reason")
}

enum OutlierFlag {
  NONE
  LOW
  HIGH

  @@map("outlier_flag")
}

/// entities.md §4.8 `PriceSource` (módulo price-research · US-026): a evidência da pesquisa (art. 23,
/// § 1º, da Lei 14.133/2021). Campos exigidos pelo tipo (`PRICE_SOURCE_TYPE.requiredFields`)
/// conferidos na aplicação; remoção física (RN-PRICE-29) com as cotações em cascata. FKs compostas,
/// checks e gatilho de colunas imutáveis na migração.
model PriceSource {
  id                          String    @id @db.Uuid
  tenantId                    String    @map("tenant_id") @db.Uuid
  priceResearchId             String    @map("price_research_id") @db.Uuid
  processId                   String    @map("process_id") @db.Uuid
  sourceTypeId                String    @map("source_type_id") @db.Uuid
  supplierId                  String?   @map("supplier_id") @db.Uuid
  description                 String    @db.VarChar(300)
  quoteDate                   DateTime? @map("quote_date") @db.Date
  accessedAt                  DateTime? @map("accessed_at") @db.Timestamptz(6)
  url                         String?   @db.VarChar(2048)
  referenceOrganization       String?   @map("reference_organization") @db.VarChar(250)
  referenceDocument           String?   @map("reference_document") @db.VarChar(120)
  supplierChoiceJustification String?   @map("supplier_choice_justification")
  notes                       String?
  sortOrder                   Int       @default(0) @map("sort_order")
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById                 String?   @map("created_by_id") @db.Uuid
  updatedById                 String?   @map("updated_by_id") @db.Uuid
  version                     Int       @default(1)

  @@unique([tenantId, id], map: "price_sources_tenant_id_id_key")
  @@index([tenantId, priceResearchId], map: "price_sources_research_idx")
  @@index([tenantId, supplierId], map: "price_sources_supplier_idx")
  @@map("price_sources")
}

/// entities.md §4.8 `Quotation` (módulo price-research · US-026): o preço de um item numa fonte,
/// único por `(price_item_id, price_source_id)`; `ON DELETE CASCADE` a partir do item e da fonte.
model Quotation {
  id                     String           @id @db.Uuid
  tenantId               String           @map("tenant_id") @db.Uuid
  priceResearchId        String           @map("price_research_id") @db.Uuid
  priceItemId            String           @map("price_item_id") @db.Uuid
  priceSourceId          String           @map("price_source_id") @db.Uuid
  unitPrice              Decimal          @map("unit_price") @db.Decimal(18, 4)
  brandModel             String?          @map("brand_model") @db.VarChar(200)
  status                 QuotationStatus  @default(VALID)
  exclusionReason        ExclusionReason? @map("exclusion_reason")
  exclusionJustification String?          @map("exclusion_justification")
  excludedById           String?          @map("excluded_by_id") @db.Uuid
  excludedAt             DateTime?        @map("excluded_at") @db.Timestamptz(6)
  outlierFlag            OutlierFlag      @default(NONE) @map("outlier_flag")
  isExpired              Boolean          @default(false) @map("is_expired")
  notes                  String?
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById            String?          @map("created_by_id") @db.Uuid
  updatedById            String?          @map("updated_by_id") @db.Uuid
  version                Int              @default(1)

  @@unique([tenantId, id], map: "quotations_tenant_id_id_key")
  @@unique([tenantId, priceItemId, priceSourceId], map: "quotations_item_source_key")
  @@index([tenantId, priceResearchId], map: "quotations_research_idx")
  @@index([tenantId, priceSourceId], map: "quotations_source_idx")
  @@map("quotations")
}
