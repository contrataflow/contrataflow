  @@unique([tenantId, id], map: "comments_tenant_id_id_key")
  @@index([tenantId, processId, createdAt(sort: Desc)], map: "comments_process_created_idx")
  @@index([tenantId, documentId, sectionKey], map: "comments_document_section_idx")
  @@index([tenantId, parentId], map: "comments_parent_idx")
  @@map("comments")
}

/// entities.md §4.9 `Mention` (US-072 · RN-CMT-22/23): um registro por alvo distinto e válido do
/// comentário — usuário xor unidade (CHECK na migração). Índices únicos parciais por alvo só na
