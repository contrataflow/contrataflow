{
  "openapi": "3.1.0",
  "info": {
    "title": "ContrataFlow API",
    "version": "1.0.0",
    "description": "API REST v1 do ContrataFlow (docs/mvp-01/api.md). Gerado — não edite à mão."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "MyProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "socialName": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "preferences": {
            "type": "object",
            "properties": {
              "density": {
                "type": "string"
              },
              "theme": {
                "type": "string"
              }
            },
            "required": [
              "density",
              "theme"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "socialName",
          "phone",
          "preferences",
          "version"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            }
          },
          "violations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Violation"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code",
          "correlationId",
          "errors",
          "violations"
        ],
        "additionalProperties": {}
      },
      "FieldError": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "REQUIRED",
              "TOO_SHORT",
              "TOO_LONG",
              "INVALID_FORMAT",
              "INVALID_ENUM",
              "OUT_OF_RANGE",
              "DATE_IN_PAST",
              "INVALID_DECIMAL",
              "INVALID_CNPJ",
              "INVALID_CPF",
              "REFERENCE_NOT_FOUND",
              "REFERENCE_INACTIVE",
              "DEPARTMENT_NOT_IN_SECRETARIAT",
              "CONDITIONAL_REQUIRED",
              "DUPLICATE_IN_LIST",
              "NOT_ALLOWED"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "code",
          "message"
        ]
      },
      "Violation": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKING",
              "WARNING"
            ]
          },
          "message": {
            "type": "string"
          },
          "ruleId": {
            "type": [
              "string",
              "null"
            ]
          },
          "sectionKey": {
            "type": [
              "string",
              "null"
            ]
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "itemId": {
            "type": [
              "string",
              "null"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "ruleId",
          "sectionKey",
          "field",
          "itemId",
          "params"
        ]
      },
      "MembershipSummary": {
        "type": "object",
        "properties": {
          "membershipId": {
            "type": "string",
            "format": "uuid"
          },
          "tenant": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PROVISIONING",
                  "ACTIVE",
                  "SUSPENDED",
                  "OFFBOARDING",
                  "DEACTIVATED"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "status"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "INTERNAL",
              "EXTERNAL",
              "SERVICE"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "INVITED",
              "ACTIVE",
              "SUSPENDED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "usable": {
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean"
          }
        },
        "required": [
          "membershipId",
          "tenant",
          "type",
          "status",
          "expiresAt",
          "usable",
          "readOnly"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/me": {
      "get": {
        "operationId": "ME-01",
        "summary": "Obter perfil do usuário autenticado",
        "tags": [
          "Sessão e perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-tenant-scope": "TENANT",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "Órgão ativo (DEC-132 · RN-TEN-19)."
            },
            "required": true,
            "description": "Órgão ativo (DEC-132 · RN-TEN-19).",
            "name": "X-Tenant-Id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do usuário (ETag = versão).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/MyProfile"
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "MALFORMED_REQUEST",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED · SESSION_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "TENANT_SUSPENDED · MEMBERSHIP_INACTIVE · MFA_REQUIRED · PERMISSION_DENIED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR · BUSINESS_RULE_VIOLATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/me/memberships": {
      "get": {
        "operationId": "ME-04",
        "summary": "Listar vínculos (instituições) do usuário",
        "tags": [
          "Sessão e perfil"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-tenant-scope": "CROSS_TENANT_LOOKUP",
        "responses": {
          "200": {
            "description": "Vínculos do usuário em todas as instituições, com `usable` consolidado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MembershipSummary"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "MALFORMED_REQUEST",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHENTICATED · SESSION_EXPIRED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "TENANT_SUSPENDED · MEMBERSHIP_INACTIVE · MFA_REQUIRED · PERMISSION_DENIED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "VALIDATION_ERROR · BUSINESS_RULE_VIOLATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "INTERNAL_ERROR",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
