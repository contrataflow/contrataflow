{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build", "//#lint:repo", "db:generate"]
    },
    "test:tenant-leak": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "openapi:generate": {
      "dependsOn": ["build"],
      "outputs": ["openapi/**"]
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
