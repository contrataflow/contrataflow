{
  "name": "@contrataflow/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST /api/v1 (NestJS 11, monólito modular — DEC-040/041).",
  "type": "module",
  "imports": {
    "#config/*": {
      "types": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#shared/*": {
      "types": "./src/shared/*",
      "default": "./dist/shared/*"
    },
    "#modules/*": {
      "types": "./src/modules/*",
      "default": "./dist/modules/*"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.spec.ts\" --delete-dir-on-start",
    "dev": "pnpm run build && concurrently --kill-others --names swc,api \"swc src -d dist --strip-leading-paths --config-file .swcrc --ignore **/*.spec.ts --watch\" \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/otel.js --watch-path=dist dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/otel.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "openapi:generate": "pnpm run build && node --enable-source-maps dist/openapi/generate.js",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "test:tenant-leak": "vitest run --config vitest.integration.config.ts test/database/tenant-isolation.spec.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "catalog:",
    "@contrataflow/editor": "workspace:*",
    "@contrataflow/observability": "workspace:*",
    "@contrataflow/types": "workspace:*",
    "@contrataflow/validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-ioredis": "catalog:",
    "@opentelemetry/instrumentation-nestjs-core": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@prisma/instrumentation": "catalog:",
    "decimal.js": "catalog:",
    "ioredis": "catalog:",
    "jose": "catalog:",
    "nestjs-pino": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contrataflow/eslint-config": "workspace:*",
    "@contrataflow/tsconfig": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chokidar": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prisma": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
