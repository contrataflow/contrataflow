{
  "name": "@contrataflow/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker assíncrono: processors BullMQ, schedulers e relay do outbox (NestJS standalone — DEC-052).",
  "type": "module",
  "imports": {
    "#config/*": {
      "types": "./src/config/*",
      "default": "./dist/config/*"
    },
    "#shared/*": {
      "types": "./src/shared/*",
      "default": "./dist/shared/*"
    },
    "#modules/*": {
      "types": "./src/modules/*",
      "default": "./dist/modules/*"
    }
  },
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc --ignore \"**/*.spec.ts\" --delete-dir-on-start",
    "dev": "pnpm run build && concurrently --kill-others --names swc,worker \"swc src -d dist --strip-leading-paths --config-file .swcrc --ignore **/*.spec.ts --watch\" \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/otel.js --watch-path=dist dist/main.js\"",
    "start": "node --enable-source-maps --import ./dist/otel.js dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests"
  },
  "dependencies": {
    "@contrataflow/editor": "workspace:*",
    "@contrataflow/observability": "workspace:*",
    "@contrataflow/types": "workspace:*",
    "@contrataflow/validation": "workspace:*",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-ioredis": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@contrataflow/eslint-config": "workspace:*",
    "@contrataflow/tsconfig": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chokidar": "catalog:",
    "concurrently": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
