{
  "name": "@contrataflow/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Scripts de engenharia do monorepo: versões fixadas, fixtures de regras, verificação de clone limpo e geradores.",
  "type": "module",
  "scripts": {
    "check:versions": "tsx check-versions.ts",
    "verify:fresh-clone": "tsx verify-fresh-clone.ts",
    "smoke:hello": "tsx smoke-hello.ts",
    "secrets:scan": "tsx scan-secrets.ts",
    "env:up": "tsx env/up.ts",
    "env:up:full": "tsx env/up.ts --profile full",
    "env:seed": "tsx env/seed.ts",
    "env:reset": "tsx env/reset.ts",
    "env:check": "tsx env/check.ts",
    "env:smoke": "tsx env/smoke.ts",
    "env:blueprint": "tsx env/blueprint.ts",
    "db:migrate": "tsx env/db-migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:tenant-leak": "tsx ci/tenant-leak.ts",
    "ci:licenses": "tsx ci/licenses.ts",
    "ci:contract": "tsx ci/contract.ts",
    "ci:coverage": "tsx ci/coverage-gate.ts",
    "ci:migrations": "tsx ci/migrations.ts",
    "ci:github-settings": "tsx ci/github-settings.ts",
    "ci:sql-lint": "tsx ci/sql-lint.ts"
  },
  "devDependencies": {
    "@commitlint/lint": "catalog:",
    "@commitlint/load": "catalog:",
    "@contrataflow/eslint-config": "workspace:*",
    "@contrataflow/tsconfig": "workspace:*",
    "@turbo/gen": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
