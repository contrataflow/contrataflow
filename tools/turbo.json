{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/.dependency-cruiser.cjs",
        "$TURBO_ROOT$/commitlint.config.mjs",
        "$TURBO_ROOT$/.github/CODEOWNERS",
        "$TURBO_ROOT$/packages/eslint-config/**",
        "$TURBO_ROOT$/infra/**",
        "$TURBO_ROOT$/.env.example",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/.dockerignore"
      ]
    }
  }
}
