{
  "uid": "cf-d1-api",
  "title": "D1 — Visão geral da API",
  "description": "SLO-01..08: disponibilidade e orçamento de erro, taxa de queima, RED por classe e rota, BFF × API, readiness e runtime (US-085 · observability.md §9).",
  "tags": ["contrataflow", "us-085", "slo", "api"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "#5794F2",
        "expr": "count by (service, version) (cf_build_info) unless count by (service, version) (cf_build_info offset 2m)",
        "step": "60s",
        "titleFormat": "Deploy {{service}}",
        "textFormat": "versão {{version}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "SLO-01 — disponibilidade e orçamento de erro",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "SLI de disponibilidade (30 dias)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_server_request_duration_seconds_count{service=\"web\", http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count{service=\"web\"}[30d])), 1))",
          "legendFormat": "SLI"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Proporção de requisições a /api/v1 (via BFF) sem 5xx no mês. Meta ≥ 99,5%."
    },
    {
      "type": "stat",
      "title": "Orçamento de erro restante (30 dias)",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - ((sum(increase(http_server_request_duration_seconds_count{service=\"web\", http_response_status_code=~\"5..\"}[30d])) / clamp_min(sum(increase(http_server_request_duration_seconds_count{service=\"web\"}[30d])), 1)) / 0.005)",
          "legendFormat": "restante"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Orçamento = 0,5% das requisições do mês (§1.2). Esgotado → congelamento de deploys não corretivos."
    },
    {
      "type": "timeseries",
      "title": "Taxa de queima (A01 ≥ 14,4× · A02 ≥ 6×)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
