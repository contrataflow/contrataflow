{
  "$comment": "Estado desejado do repositório no GitHub (US-079). Aplicar: GH_TOKEN=<admin> pnpm ci:github-settings --apply --repo <dono/nome>. Os required checks precisam ser os nomes exatos dos jobs de .github/workflows/ci.yml (teste em tools/test/ci-pipeline.test.ts). Os revisores obrigatórios por caminho vêm do .github/CODEOWNERS (teamReviewersFromCodeowners). Modo mantenedor único (DEC-067): 0 aprovações, sem CODEOWNERS obrigatório e autoaprovação em production; reverter conforme a DEC-067 quando entrar a segunda pessoa.",
  "organization": "contrataflow",
  "repository": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": true,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "PR_BODY",
    "delete_branch_on_merge": true,
    "allow_update_branch": true
  },
  "actions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "fork_pr_approval_policy": "all_external_contributors"
  },
  "ruleset": {
    "name": "main — gates da US-079",
    "requiredStatusChecks": [
      "1. Higiene",
      "2. Estático",
      "2. Estático (CodeQL)",
      "3. Contrato",
      "4. Testes",
      "5. Migrações",
      "6. Imagens",
      "7. E2E"
    ],
    "strict": true,
    "teamReviewersFromCodeowners": false,
    "pullRequest": {
      "required_approving_review_count": 0,
      "require_code_owner_review": false,
      "dismiss_stale_reviews_on_push": true,
      "require_last_push_approval": false,
      "required_review_thread_resolution": true,
      "allowed_merge_methods": ["squash"]
    },
    "codeScanning": {
      "tool": "CodeQL",
      "security_alerts_threshold": "high_or_higher",
      "alerts_threshold": "errors"
    }
  },
  "environments": [
    {
      "name": "staging",
      "reviewers": [],
      "wait_timer": 0,
      "prevent_self_review": false
    },
    {
      "name": "production",
      "reviewers": ["tech-lead"],
      "wait_timer": 0,
      "prevent_self_review": false
    }
  ]
}
