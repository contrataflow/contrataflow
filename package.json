{
  "name": "contrataflow",
  "version": "0.0.0",
  "private": true,
  "description": "ContrataFlow — fase preparatória das contratações públicas (Lei 14.133/2021).",
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=10.34.6 <11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @contrataflow/tools run env:check && turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "cf": "pnpm --filter @contrataflow/api run cf",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err-long",
    "lint:repo": "prettier . --check --log-level warn && eslint . --max-warnings=0",
    "format": "prettier . --write --log-level warn",
    "check:versions": "pnpm --filter @contrataflow/tools run check:versions",
    "verify:fresh-clone": "pnpm --filter @contrataflow/tools run verify:fresh-clone",
    "smoke:hello": "pnpm --filter @contrataflow/tools run smoke:hello",
    "secrets:scan": "pnpm --filter @contrataflow/tools run secrets:scan",
    "ci:licenses": "pnpm --filter @contrataflow/tools run ci:licenses",
    "ci:contract": "pnpm --filter @contrataflow/tools run ci:contract",
    "ci:coverage": "pnpm --filter @contrataflow/tools run ci:coverage",
    "ci:migrations": "pnpm --filter @contrataflow/tools run ci:migrations",
    "ci:sql-lint": "pnpm --filter @contrataflow/tools run ci:sql-lint",
    "ci:github-settings": "pnpm --filter @contrataflow/tools run ci:github-settings",
    "env:up": "pnpm --filter @contrataflow/tools run env:up",
    "env:up:full": "pnpm --filter @contrataflow/tools run env:up:full",
    "env:seed": "pnpm --filter @contrataflow/tools run env:seed",
    "env:reset": "pnpm --filter @contrataflow/tools run env:reset",
    "env:check": "pnpm --filter @contrataflow/tools run env:check",
    "env:smoke": "pnpm --filter @contrataflow/tools run env:smoke",
    "env:blueprint": "pnpm --filter @contrataflow/tools run env:blueprint",
    "db:migrate": "pnpm --filter @contrataflow/tools run db:migrate",
    "ai:eval": "pnpm --filter @contrataflow/api run ai:eval --",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
